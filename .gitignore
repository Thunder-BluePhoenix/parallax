# ─── Parallax Runtime Data ───────────────────────────────────────────────────
# Sensitive environments — never commit prod secrets
.parallax/environments/prod.json
.parallax/environments/staging.json
.parallax/environments/*.secret.json

# Cookie jar — session data
.parallax/cookies/

# Request history — can be large and is machine-specific
.parallax/history/

# Health database
.parallax/health.db
.parallax/health.db-shm
.parallax/health.db-wal

# Load test and run reports — generated output
.parallax/reports/

# AI config — contains API keys
.parallax/ai.json

# Generated docs output
.parallax/docs/

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

